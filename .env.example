# ============================================================
# JanNyaya AI - Environment Configuration Example
# ============================================================

# Groq API Key (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM & Speech Model Settings
GROQ_MODEL=openai/gpt-oss-120b
SPEECH_MODEL=whisper-large-v3
LLM_MAX_TOKENS=650

# Legal RAG Configuration
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=5000
RAG_MAX_SOURCE_TEXT_CHARS=2500
RAG_MAX_FACT_GROUPS=1

# Document Analysis Parameters
DOCUMENT_ANALYSIS_MAX_TOKENS=600
DOCUMENT_ANALYSIS_MAX_CHARS=18000
